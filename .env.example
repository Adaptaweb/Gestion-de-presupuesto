# --- Obligatorias: el servidor no arranca sin ellas ---

# Firma de los tokens de sesion. Sin valor por defecto a proposito.
# Generar con: openssl rand -base64 32
JWT_SECRET=

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:tu_contraseña@db.xxx.supabase.co:5432/postgres

# --- Seguridad ---

# Secreto compartido con el Worker de correo de Cloudflare.
# Sin este valor, /api/webhook/email responde 503 y no procesa nada.
# Generar con: openssl rand -hex 32
WEBHOOK_SECRET=

# Origenes permitidos por CORS, separados por comas.
ALLOWED_ORIGINS=https://gastos.adaptaweb.cl,http://localhost:5173

# --- Integraciones ---

PORT=3000
NODE_ENV=production

GMAIL_CLIENT_ID=tu_client_id_aqui
GMAIL_CLIENT_SECRET=tu_client_secret_aqui
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui

# Correo transaccional
RESEND_API_KEY=tu_resend_api_key_aqui

# Gemini AI (frontend + parseo de transacciones en el servidor)
VITE_GEMINI_API_KEY=tu_gemini_api_key_aqui

# OpenRouter (alternativa a Gemini para parseo de transacciones)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# Web Push (VAPID) para notificaciones PWA
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kuentasklaras.cl
