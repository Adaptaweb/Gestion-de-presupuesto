{
  "framework": "vite",
  "buildCommand": "npm run migrate && npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron/billing", "schedule": "0 13 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/oauth2callback",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
